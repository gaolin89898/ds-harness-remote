{
  "manifest_version": 3,
  "name": "Kite",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "1.0.0",
  "icons": {
    "128": "media/icon.png"
  },
  "action": {
    "default_title": "Kite",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "media/icon.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://dsh.gaolin.ink/*"]
}
